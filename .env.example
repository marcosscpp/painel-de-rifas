# Copie para .env. Em dev tudo tem padrão no docker-compose.yml; em produção todos são obrigatórios.

DOMAIN=rifas.exemplo.com.br

POSTGRES_USER=rifas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=rifas

S3_ACCESS_KEY=rifas
S3_SECRET_KEY=troque-esta-senha-tambem
S3_BUCKET=rifas

# Gere com: openssl rand -hex 32
JWT_SECRET=

# Criptografia de CPF, celular, e-mail, nascimento e endereço dos compradores.
# Gere cada chave com: openssl rand -base64 32
# PII_KEYS aceita várias versões ("1:<chave>,2:<chave>"): a API grava com a mais alta e,
# ao subir, recifra o que estava na antiga. Nunca apague uma versão antes disso terminar.
# Sem essas chaves os dados não podem ser lidos: guarde uma cópia fora do servidor.
PII_KEYS=1:
PII_INDEX_KEY=
SESSION_TTL_MINUTES=480

# FAKE em dev; ASAAS ou IUGU em produção
PAYMENT_PROVIDER=FAKE
PAYMENT_API_KEY=
# Asaas: https://api-sandbox.asaas.com/v3 (teste) ou https://api.asaas.com/v3 (produção)
PAYMENT_BASE_URL=
# Obrigatório em produção (24+ caracteres), configurado também no painel do gateway
PAYMENT_WEBHOOK_TOKEN=

# R$ 1,99 por pedido, repassado ao comprador
PIX_FEE_CENTS=199
RESERVATION_MINUTES=15

# Primeiro admin (usado só pelo comando admin:create)
ADMIN_EMAIL=
ADMIN_PASSWORD=
