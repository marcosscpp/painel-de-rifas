# Local execution: copy to .env and export values into the process environment.
# Spring Boot does not load .env automatically; Docker Compose does.
SPRING_PROFILES_ACTIVE=mock
HTTP_LOG_LEVEL=INFO
API_PORT=3333
DB_PORT=5433
POSTGRES_USER=rifas
POSTGRES_PASSWORD=rifas
POSTGRES_DB=rifas
ADMIN_EMAIL=admin@rifas.local
ADMIN_PASSWORD=admin-dev-123456
# Required by real profile (32 random bytes encoded as Base64):
PII_ENCRYPTION_KEY=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_TOKEN=
PAYMENT_BASE_URL=https://api-sandbox.asaas.com/v3
S3_ACCESS_KEY=rifas
S3_SECRET_KEY=rifas-secret
S3_BUCKET=rifas
DOMAIN=
