# Copie para .env. Em dev tudo tem padrão no docker-compose.yml; em produção todos são obrigatórios.

DOMAIN=rifas.exemplo.com.br

POSTGRES_USER=rifas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=rifas

S3_ACCESS_KEY=rifas
S3_SECRET_KEY=troque-esta-senha-tambem
S3_BUCKET=rifas

JWT_SECRET=gere-com-openssl-rand-hex-32

# FAKE em dev; ASAAS ou IUGU em produção
PAYMENT_PROVIDER=FAKE
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_TOKEN=

# R$ 1,99 por pedido, repassado ao comprador
PIX_FEE_CENTS=199
RESERVATION_MINUTES=15
