// Modelo do escopo A (ver docs/MODELO.md). Valores em centavos (Int).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Usuários ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  BUYER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  role         Role     @default(BUYER)
  name         String
  phone        String?  @unique // obrigatório para comprador (validado na API)
  cpf          String?  @unique
  email        String?  @unique
  passwordHash String? // só admin usa senha (argon2id)
  sessionVersion Int    @default(0) // incrementar derruba todas as sessões do usuário
  gatewayCustomerId String? // id do cliente no gateway (Asaas exige cadastro antes da cobrança)

  // Cadastro do comprador (mesmos campos do checkout do Wesley Alemão; endereço é opcional)
  socialName   String?
  birthDate    DateTime? @db.Date
  zipCode      String?
  street       String?
  streetNumber String?
  district     String?
  city         String?
  state        String? // UF
  complement   String?
  reference    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@map("users")
}

// ─── Rifas ───────────────────────────────────────────────────────────────────

enum RaffleStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED // vendas encerradas, aguardando sorteio
  DRAWN // resultado publicado
}

// Definido pelo admin em cada rifa; o comprador não escolhe.
enum SaleMode {
  QUANTITY // roleta: o comprador escolhe a quantidade e recebe números aleatórios
  PICK // grade: o comprador escolhe os números
}

model Raffle {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique
  title        String
  description  String
  rules        String       @default("")
  status       RaffleStatus @default(DRAFT)
  saleMode     SaleMode     @default(QUANTITY)
  totalNumbers Int
  priceCents   Int
  minPerOrder  Int          @default(1)
  maxPerOrder  Int          @default(1000)
  startsAt     DateTime?
  endsAt       DateTime?
  drawDate     DateTime?
  coverKey     String? // prefixo da capa no MinIO (ex.: raffles/<id>/cover-<uuid>); front usa -400/-1200.webp

  // Contadores mantidos na mesma transação da reserva/pagamento: progresso sem COUNT em milhões de linhas.
  paidCount     Int       @default(0)
  reservedCount Int       @default(0)
  publishedAt   DateTime?

  // Resultado (Loteria Federal)
  lotteryContest String? // número do concurso
  lotteryResult  String? // número sorteado pela Loteria
  winningNumber  Int? // número da rifa após a regra de conversão
  drawnAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages RafflePackage[]
  prizes   Prize[]
  orders   Order[]

  @@index([status, createdAt])
  @@map("raffles")
}

model RafflePackage {
  id          String  @id @default(uuid()) @db.Uuid
  raffleId    String  @db.Uuid
  quantity    Int
  highlighted Boolean @default(false)
  position    Int     @default(0)

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, quantity])
  @@map("raffle_packages")
}

enum PrizeKind {
  MONEY
  ITEM
}

model Prize {
  id          String    @id @default(uuid()) @db.Uuid
  raffleId    String    @db.Uuid
  position    Int       @default(1) // 1º prêmio, 2º prêmio...
  title       String
  description String    @default("")
  kind        PrizeKind @default(ITEM)
  valueCents  Int?

  raffle Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  images PrizeImage[]

  @@map("prizes")
}

model PrizeImage {
  id       String @id @default(uuid()) @db.Uuid
  prizeId  String @db.Uuid
  key      String // prefixo no MinIO; arquivos -400.webp e -1200.webp
  position Int    @default(0)

  prize Prize @relation(fields: [prizeId], references: [id], onDelete: Cascade)

  @@map("prize_images")
}

// ─── Números ─────────────────────────────────────────────────────────────────
// Uma linha por número, pré-gerada ao publicar a rifa. A reserva usa
// SELECT ... FOR UPDATE SKIP LOCKED (SQL cru), nos dois modos de venda.
// A expiração parte de orders(status, expiresAt) e libera os números pelo orderId.

enum NumberStatus {
  AVAILABLE
  RESERVED
  PAID
}

model RaffleNumber {
  raffleId      String       @db.Uuid
  number        Int
  status        NumberStatus @default(AVAILABLE)
  orderId       String?      @db.Uuid
  reservedUntil DateTime?

  // Sem FK para raffles de propósito: a checagem por linha deixava a publicação de 1 milhão
  // de números ~5x mais lenta. Só o publish insere aqui, e rifa publicada não pode ser apagada.
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@id([raffleId, number])
  // number no fim do índice: varrer livres em ordem sem ordenar a tabela toda.
  @@index([raffleId, status, number])
  @@index([orderId])
  @@map("raffle_numbers")
}

// ─── Pedidos e pagamentos ────────────────────────────────────────────────────

enum OrderStatus {
  PENDING // aguardando Pix, números reservados
  PAID
  EXPIRED // passou dos 15 min, números liberados
  CANCELED
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  raffleId       String      @db.Uuid
  userId         String      @db.Uuid
  quantity       Int
  subtotalCents  Int // quantidade x preço
  feeCents       Int // taxa Pix repassada (R$ 1,99 por pedido)
  totalCents     Int
  status         OrderStatus @default(PENDING)
  idempotencyKey String      @unique // enviada pelo front, evita pedido duplicado
  // Números reservados na criação. Ficam guardados mesmo depois de expirar, para
  // tentar devolvê-los a quem pagou atrasado.
  reservedNumbers Int[]      @default([])
  // Pagou depois de expirar e algum número já tinha sido vendido: reembolsar pelo painel.
  refundRequired Boolean     @default(false)
  expiresAt      DateTime
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  raffle  Raffle         @relation(fields: [raffleId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  numbers RaffleNumber[]
  payment Payment?

  @@index([raffleId, status])
  @@index([userId])
  @@index([status, expiresAt])
  @@map("orders")
}

enum PaymentProvider {
  ASAAS
  IUGU
  FAKE // desenvolvimento
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
  REFUNDED
}

model Payment {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @unique @db.Uuid
  provider         PaymentProvider
  providerChargeId String
  amountCents      Int
  status           PaymentStatus   @default(PENDING)
  pixQrCodeBase64  String?
  pixCopyPaste     String?
  confirmedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, providerChargeId])
  @@map("payments")
}

// Cada webhook recebido é gravado uma vez; repetido = ignorado (idempotência).
model WebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  receivedAt  DateTime        @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ─── Configurações ───────────────────────────────────────────────────────────
// Chave/valor editável pelo admin: taxa Pix, minutos de reserva, logo, cores...
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
