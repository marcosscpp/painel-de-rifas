# Destino do proxy de desenvolvimento: API Spring Boot executada pelo IntelliJ.
# Deve corresponder a server.port / PORT do backend.
API_PROXY_TARGET=http://localhost:3000

# Base pública usada por HTTP, uploads, downloads e SSE.
# Mantenha /api para usar o proxy local e o Caddy em produção.
VITE_API_BASE_URL=/api
VITE_APP_NAME=WinClub

# Logs HTTP no console do navegador. O padrão é true em dev e false em produção.
# VITE_API_LOGGING=true
